# Configuração local do D.A.N.T.E. como serviço.
# deploy/dante-service.sh copia este modelo para ~/.config/dante/dante.env com permissão 600.
# Esse arquivo guarda segredos: nunca o versione nem o copie para dentro do repositório.
# Formato do systemd (EnvironmentFile): CHAVE=valor, sem "export".

Telegram__BotToken=
Telegram__AllowedUserIds=

# Workspace do General Mode (path absoluto, fora de repositórios cadastrados).
# DANTE_GENERAL_WORKSPACE=/home/<usuario>/.dante/workspaces/general

# Variáveis do host referenciadas por /repo env bind.
# FITNESS_DATABASE_PASSWORD=

# Opcional: as CLIs usam a autenticação local (~/.claude, ~/.codex) por padrão.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Modelo de transcrição, opcional se usar o caminho padrão ~/.dante/models/ggml-small.bin.
# Valores do serviço são literais: substitua <usuario>, sem $HOME nem ~.
# DANTE_WHISPER_MODEL=/home/<usuario>/.dante/models/ggml-small.bin

# SDK instalado por usuário; dispense para instalação de sistema.
# DOTNET_ROOT=/home/<usuario>/.dotnet

# O serviço não carrega .bashrc/NVM. Inclua o diretório real de node/codex e os demais.
# Atualize este caminho se trocar a versão do Node; preserve os diretórios básicos.
# PATH=/home/<usuario>/.nvm/versions/node/v22.20.0/bin:/home/<usuario>/.local/bin:/home/<usuario>/.dotnet:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
