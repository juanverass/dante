<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dante.Application/Dante.Application.csproj" />
    <ProjectReference Include="../Dante.Infrastructure/Dante.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Compatibilidade temporária da #166 (AD-38): tipos legados movidos para o núcleo mantêm o uso sem namespace. -->
  <ItemGroup>
    <Using Include="Dante.Application.Contextos" />
    <Using Include="Dante.Domain.Agentes" />
    <Using Include="Dante.Domain.Contextos" />
    <Using Include="Dante.Domain.Preferencias" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dante.Tests" />
  </ItemGroup>
</Project>
